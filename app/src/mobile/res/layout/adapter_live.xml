<?xml version="1.0" encoding="utf-8"?>
<!-- 直播源列表项（手机版）：与主数据源弹窗行（选择模式）同构 ——
     shape_site_pick_row（10dp 圆角淡白行 + 按下主色高亮），内边距由这里显式补 12/8dp
     （shape_site_pick_row 本身无 padding，与 SiteManageAdapter 选择模式同一套）。 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/shape_site_pick_row"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="16sp"
        tools:text="泥巴" />

    <!-- 行尾「使用中」标注：与配置历史弹窗家族同一配色（site_state_color） -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:singleLine="true"
        android:textColor="@color/site_state_color"
        android:textSize="16sp"
        tools:text="使用中" />

</androidx.appcompat.widget.LinearLayoutCompat>
