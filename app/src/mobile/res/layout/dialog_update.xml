<?xml version="1.0" encoding="utf-8"?>
<!-- 发现新版本弹窗内容（手机版）。
     标题由 builder().setTitle() 提供，所以这里只有正文；两个动作按钮走
     builder 的 negative / positive（M3 默认 TextButton），不自己画按钮行 ——
     与手机版其它弹窗（dialog_confirm / ArrayPickDialog）完全同构。
     深色主题下文字走 white_80 / white_60，主色走 ?attr/colorPrimary（随设备动态取色）。 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white_80"
        android:textSize="14sp"
        tools:text="当前版本 6.5.0" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/latest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="14sp"
        tools:text="最新版本 6.5.2" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/white_60"
        android:textSize="12sp"
        tools:text="安装包 94.6 MB" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/shape_site_pick_row"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/update_view_log"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="›"
            android:textColor="@color/white_60"
            android:textSize="16sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
