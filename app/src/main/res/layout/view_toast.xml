<?xml version="1.0" encoding="utf-8"?>
<!-- 全局浮层提示（Toast）：app 内自绘，文字用 sp 字号 ——
     电视版会随「字号大小」档位与屏幕尺寸补偿等比放大，不再使用系统 Toast 的小字号。

     ⚠ 手机版实际走不到这份布局：Notify.create() 里只有 leanback 分支 inflate(R.layout.view_toast)，
     mobile 分支用系统 Toast（Toast.makeText）。本文件因此会作为「未引用资源」被打进 mobile 包，
     属已知的良性冗余 —— 保留它是因为它是 Notify 的唯一布局契约来源，删除会让
     「leanback 覆盖版一旦漏删就编译失败」的风险升高。需要清掉时应连同 leanback 覆盖版一起处理。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_toast"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <TextView
    android:id="@+id/text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:textColor="@color/white"
    android:textSize="24sp" />

</LinearLayout>
