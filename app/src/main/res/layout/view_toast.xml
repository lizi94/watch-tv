<?xml version="1.0" encoding="utf-8"?>
<!-- 全局浮层提示（Toast）：app 内自绘，文字用 sp 字号 ——
     电视版会随「字号大小」档位与屏幕尺寸补偿等比放大，不再使用系统 Toast 的小字号。

     ⛔ 2026-11-09（R138）手机端 Toast 样式统一：
     之前手机端走系统 Toast（Toast.makeText），样式随手机深浅色模式翻转、字号偏小、不可控，
     与电视端的深色圆角白字观感割裂。现在 Notify.makeTextInternal 的 mobile 分支也 inflate
     本布局 —— 双端同一入口、同一观感：深色半透明圆角 + 白字居中，不随系统主题变。
     手机端无「字号档位」缩放，15sp 起步、autoSize 缩到 12sp 兜底、最多 2 行、超长省略。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_toast"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="10dp">

    <!-- ⚠ 与 leanback 覆盖版保持同一套「限行 + 自动缩放」契约（见那份的说明）。 -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:autoSizeMaxTextSize="15sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform" />

</LinearLayout>
