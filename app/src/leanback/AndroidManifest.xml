<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 电池优化白名单（R101）：体检页「让电视别把看电视关掉」用它一口气跳到系统的
         「是否允许后台运行」确认框（ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS），
         比让老人自己去「设置 → 电池 → 白名单」里翻要省事得多。这是普通权限（无弹窗、
         无隐私面），真正的授权动作由系统弹框完成，用户随时可拒。
         ⚠ 若某台电视的固件裁掉了这个确认页，跳转会失败 —— 体检页里已有兜底（见 SelfCheckActivity）。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 应用管理「卸载应用」：ACTION_DELETE 对别的包发起卸载在 API 26+ 必须声明本权限，
         不加则静默失败（部分 ROM 连提示都没有）。normal 级权限，无需运行时请求。 -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android 11+ 默认有包可见性过滤，未在 queries 里声明的包查不到。
         ① MAIN+HOME：桌面守护用。没有它，DesktopResolver 的 queryIntentActivities(MAIN+HOME)
            在 Android 12/13 的电视与盒子上会返回空集 —— 被误判成「本应用就是默认桌面」
            ⇒ 主页键接管静默失效。
         ② MAIN+LAUNCHER / MAIN+LEANBACK_LAUNCHER（R101 应用列表）：缺了这两条，
            AppQuery 在 Android 11+ 上会直接返回空列表（应用页一片空白）。
            电视应用多数只声明 LEANBACK_LAUNCHER，手机应用只声明 LAUNCHER，两者都要。
         这里只是「可见」，不需要任何运行时权限，也不会增加弹窗。声明在 leanback 源集里，
         手机端不受影响。
         ⛔ 不要图省事改成 QUERY_ALL_PACKAGES：那是给「枚举没有启动入口的应用」用的，
            而这类应用本来也点不开；多一个敏感权限只多一处 OEM 差异。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application android:banner="@mipmap/ic_banner">

        <!-- 这里原有 design_width_in_dp=1920 / design_height_in_dp=1080 两条 meta-data（供
             AndroidAutoSize 使用）。2026-10-12 已随 autosize 依赖一并移除：本项目的密度完全由
             BaseActivity#hackResources 统一计算，若在 build.gradle 里加回 autosize，必须同步把
             这两条加回来，否则 AutoSize 会因缺少设计尺寸而抛 IllegalArgumentException。 -->

        <activity
            android:name=".ui.activity.HomeActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.App">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- ⛔⛔ 2026-10-29 加入、2026-10-30（R103）删除、**2026-11-04（R101）恢复**。
                 恢复的理由（与 R103 删除的理由逐条对照，缺一不可）：
                   R103 说「多一个 HOME 候选 ⇒ 默认桌面为空时会弹「选择桌面」，老人误选后出不去」。
                   R101 用「应用列表 + 标题栏设置 + 状态表出口」解掉了「出不去」那一半：
                     · 首页按返回键在默认桌面形态下**无动作**（不再 finish 后又被系统拉回来）；
                     · 应用列表第一格固定「系统设置」，列表右上胶囊给出「换回电视自带的主页」；
                     · 体检页 + 安全阀（本机只剩自己一个 HOME 候选时首页常驻告警条）。
                   而 R103 保留的另一半理由「提前加载」确实不成立 —— 所以这一条**只买个桌面身份**，
                   不指望它带来任何启动加速。
                 ⚠ 若将来要再删掉它，上述三个出口必须一起评估，不能只删声明。
                 ⚠ `launchMode` 必须同时是 singleTask（见下面 HomeActivity 上的注释）。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- ⛔ `launchMode` 是 **singleTask**（R101 从 singleTop 改来），这条与上面的 HOME
                 intent-filter 是一对，不能只改一个：
                 singleTop 下，用户在「应用列表」或「播放页」（同一 task 里压在首页之上）按主页键时，
                 HOME 意图会在栈顶**再建一个首页实例** ⇒ 看着对了，但按返回又回到应用列表，
                 而且实例会越叠越多（内存与生命周期都乱）。
                 singleTask 才是桌面的正确语义：HOME 意图投递给已有实例（走 onNewIntent）并清掉它上面的页面。
                 迁移面已核对：BootLauncher 用 NEW_TASK|CLEAR_TOP|SINGLE_TOP、BaseActivity#goHome() 用
                 CLEAR_TOP|SINGLE_TOP —— 两种标志在 singleTask 下语义不变或更严格，不会退化。 -->

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="smb" />
                <data android:scheme="rtmp" />
                <data android:scheme="rtsp" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="ed2k" />
                <data android:scheme="magnet" />
                <data android:scheme="thunder" />
                <data android:scheme="jianpian" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.CastActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="${applicationId}.cast" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.LiveActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.activity.HomeActivity"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.VideoActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation|keyboard|keyboardHidden|navigation"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.activity.HomeActivity"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.KeepActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <!-- 应用列表（R101）：首页功能行「应用」的落点，也是默认桌面形态下唯一的出口。
             第一格固定「系统设置」，保证「进了第三方桌面也能回到系统」。
             它是首页之上的一个普通页面，返回键回首页（覆写 backToHome() 返回 false）。 -->
        <activity
            android:name=".ui.activity.AppListActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <!-- 启动与桌面体检（R101）：长辈设置里的一行入口，四行状态 + 「一键检查并修复」。 -->
        <activity
            android:name=".ui.activity.SelfCheckActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.HistoryActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.PushActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.SearchActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="stateHidden" />

        <activity
            android:name=".ui.activity.CollectActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.FileActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.SettingActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.ElderLockActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.ElderSettingsActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.SiteManageActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.SettingPlayerActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.SettingDecodeActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.SettingPreloadActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.activity.SettingDanmakuActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="sensorLandscape" />

        <service
            android:name=".service.DLNARendererService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 桌面守护（2026-10-29）：按主页键回到电视桌面时自动切回本软件。
             必须 exported=true + BIND_ACCESSIBILITY_SERVICE 权限，否则系统无法绑定。 -->
        <service
            android:name=".service.HomeGuardService"
            android:exported="true"
            android:label="@string/accessibility_home_guard_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_home_guard" />
        </service>

        <!-- 通知监听保活（2026-10-29）：不读通知内容，只借系统绑定把进程留住 / 拉回。
             需要用户在「通知使用权」里授权，或用 adb：
             cmd notification allow_listener com.fongmi.android.tv/com.fongmi.android.tv.service.RevivalListener -->
        <service
            android:name=".service.RevivalListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 开机自启（2026-10-29 新增；2026-10-30 R100 补早期路径、R103 补预热入口）
             directBootAware=true 是 LOCKED_BOOT_COMPLETED 的必要条件：这条广播在用户解锁前就发，
             实测 TCL 上它比 BOOT_COMPLETED（被固件拖到开机约 80 秒）早得多。
             四个 action 各自的作用：
               LOCKED_BOOT_COMPLETED —— 最早的一次机会，预热进程；已解锁则立刻拉起界面
               USER_UNLOCKED         —— 未解锁时先挂着，解锁瞬间再拉（仅开机 5 分钟内有效）
               BOOT_COMPLETED        —— 原来的兜底路径，保留不动
               BOOT_PREHEAT          —— 本应用自发信号：媒体库服务被系统绑定说明进程已被拉起，
                                        用于厂商拦掉 BOOT_COMPLETED 的机型（仅开机 120 秒内有效） -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:priority="999">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>

            <!-- 2026-10-30（R103）：包内预热广播，由 PlaybackService#onCreate 用 setPackage 发出，
                 外部应用无法伪造。对应常量 App#ACTION_PREHEAT，两处字符串必须一致。 -->
            <intent-filter>
                <action android:name="${applicationId}.action.BOOT_PREHEAT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
