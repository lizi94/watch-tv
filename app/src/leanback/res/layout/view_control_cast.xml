<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/shape_controller"
    android:orientation="vertical"
    android:paddingStart="@dimen/ag_space_6"
    android:paddingTop="@dimen/ag_space_6"
    android:paddingEnd="@dimen/ag_space_6"
    android:paddingBottom="@dimen/ag_space_4">

    <androidx.media3.ui.PlayerSeekView
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ag_space_3" />

    <include
        android:id="@+id/action"
        layout="@layout/view_control_cast_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</androidx.appcompat.widget.LinearLayoutCompat>
