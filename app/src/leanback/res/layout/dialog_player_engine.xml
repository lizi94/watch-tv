<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/ag_space_6"
        android:paddingTop="@dimen/ag_space_6"
        android:paddingBottom="@dimen/ag_space_4">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/player_engine"
            android:textColor="@color/ag_text"
            android:textSize="@dimen/ag_text_label" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/debug"
            app:tint="@color/ag_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_debug"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:src="@drawable/ic_action_debug" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ag_space_6"
        android:paddingEnd="@dimen/ag_space_6"
        android:paddingBottom="@dimen/ag_space_6">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/exo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ag_space_2"
            android:background="@drawable/selector_chip_round"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/play_exo"
            android:textColor="@color/text"
            android:textSize="@dimen/ag_text_body" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mpv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ag_space_2"
            android:background="@drawable/selector_chip_round"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/play_mpv"
            android:textColor="@color/text"
            android:textSize="@dimen/ag_text_body" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/other"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_chip_round"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/play_other"
            android:textColor="@color/text"
            android:textSize="@dimen/ag_text_body" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
