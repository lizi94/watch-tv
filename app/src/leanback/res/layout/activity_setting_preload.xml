<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="NestedWeights">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:padding="@dimen/ag_space_6">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Ag.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ag_space_4"
            android:text="@string/player_preload_setting" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/preload"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/player_preload" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/preloadText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Off" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/preloadNext"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/player_preload_next" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/preloadNextText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Off" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/preloadThread"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/player_preload_threads" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/preloadThreadText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="1" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/preloadSize"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/player_preload_size" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/preloadSizeText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="512 MB" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/preloadTime"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/player_preload_time" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/preloadTimeText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="60 s" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
