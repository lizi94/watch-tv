<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/ag_func_size"
    android:layout_height="@dimen/ag_func_size"
    android:background="@drawable/selector_item"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/ag_icon_36"
        android:layout_height="@dimen/ag_icon_36"
        android:tint="@color/ag_text"
        tools:src="@drawable/ic_home_search" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ag_space_2"
        android:textColor="@color/ag_text"
        android:textSize="@dimen/ag_text_body"
        tools:text="看电视" />

</androidx.appcompat.widget.LinearLayoutCompat>