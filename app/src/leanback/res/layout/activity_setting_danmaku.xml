<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="NestedWeights">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:padding="@dimen/ag_space_6">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Ag.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ag_space_4"
            android:text="@string/setting_danmaku" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/danmakuLoad"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/danmaku_load" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/danmakuLoadText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="關" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/danmakuApi"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/danmaku_api" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/danmakuApiText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                tools:text="https://" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/danmakuAuto"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/danmaku_auto_load" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/danmakuAutoText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="關" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/danmakuSpider"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/danmaku_spider_first" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/danmakuSpiderText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="關" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
