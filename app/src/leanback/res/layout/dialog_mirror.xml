<?xml version="1.0" encoding="utf-8"?>
<!-- 下载源选择弹窗（电视版）。
     与 dialog_doh.xml 同一套列表做法：CustomRecyclerView + app:maxHeight 限高，
     超过就滚动。这里额外加了标题与「重新测速」按钮，所以不能用 RecyclerView 直接作根。
     ⛔ 高度必须由 maxHeight 兜住（不能 wrap_content 无限长）：
        否则标题+列表+按钮的总高会超过弹窗可用高度，最后那个按钮会被挤出屏幕。
     延迟三档颜色在 adapter 里按值 setTextColor（复用 ag_* 现有色值），不新建色选择器。 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/ag_space_7">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        style="@style/Ag.Text.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_source_title" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/summary"
        style="@style/Ag.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ag_space_2"
        tools:text="已测速 8 个节点 · 点击即选定" />

    <com.fongmi.android.tv.ui.custom.CustomRecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ag_space_5"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:maxHeight="@dimen/ag_dialog_list_max"
        tools:itemCount="4"
        tools:listitem="@layout/adapter_mirror" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/retest"
        style="@style/Ag.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ag_button_h"
        android:layout_marginTop="@dimen/ag_space_5"
        android:singleLine="true"
        android:text="@string/update_retest" />

</androidx.appcompat.widget.LinearLayoutCompat>
