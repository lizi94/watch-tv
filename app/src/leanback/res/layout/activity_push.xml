<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ag_bg"
    android:gravity="center"
    android:orientation="vertical">

    <!-- 本页是纯展示页：二维码 + 局域网地址。
         ⛔ 2026-11-06（R112）：原先还有一个「推送剪贴板内容」按钮，已整块删除 ——
         它只在支持跨设备剪贴板同步的生态里才有意义，普通电视的剪贴板永远是空的；
         而且它上游从来没有 focusable（遥控器选不中），修好焦点后一点就崩（把任意文本当视频地址）。
         现在页面上没有可聚焦项，遥控器按返回键退出即可；二维码仅供鼠标 / 触摸屏点击。 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/code"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:focusable="false"
        android:scaleType="fitXY" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/info"
        style="@style/Ag.Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ag_space_6"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/ag_space_2" />

</androidx.appcompat.widget.LinearLayoutCompat>
