<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ag_bg"
    android:gravity="center"
    android:orientation="vertical">

    <!-- 二维码：只给鼠标 / 触摸屏用。电视遥控器不参与 —— 显式 focusable=false，
         避免焦点停在「按下也只会去调系统浏览器」的图片上（电视多半没有浏览器）。
         遥控器真正要操作的是下面那个按钮。 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/code"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:focusable="false"
        android:scaleType="fitXY" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/info"
        style="@style/Ag.Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ag_space_6"
        android:gravity="center"
        android:lineSpacingExtra="8dp" />

    <!-- 2026-11-05（R107）：这里原来是裸 TextView + shape_item_normal，
         既没有 focusable 也没有焦点态 —— 遥控器根本选不中，
         等于「推送剪贴板内容」这个功能在电视上不存在。
         改挂 Ag.Button.Primary：自带 focusable / 64dp 高 / 焦点环 / padding。 -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/clip"
        style="@style/Ag.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ag_button_h"
        android:layout_marginTop="@dimen/ag_space_4"
        android:text="@string/push_clip" />

</androidx.appcompat.widget.LinearLayoutCompat>
