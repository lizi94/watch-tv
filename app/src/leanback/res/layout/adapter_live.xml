<?xml version="1.0" encoding="utf-8"?>
<!-- 直播源列表项（电视版）：与主数据源弹窗行（adapter_site_manage.xml）同构 ——
     Ag.ListItem 自带 selector_item 焦点框与 64dp 触控高度，文字走 Ag.Text.Body。
     @id/text 与主数据源行同名同类型；@id/state 由行尾标注「使用中」（同配置历史弹窗家族）。
     ⛔ 点击绑整行根（LiveAdapter）—— Ag.ListItem 的 focusable 在根布局上，
     绑在 text 上遥控器 OK 键根本不触发（R119 引入的回归，R122 修复）。 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Ag.ListItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ag_space_2"
    android:orientation="horizontal">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        style="@style/Ag.Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        tools:text="https://fongmi.github.io/live.json" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/state"
        style="@style/Ag.Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ag_space_3"
        android:singleLine="true"
        android:textColor="@color/site_state_color"
        tools:text="使用中" />

</androidx.appcompat.widget.LinearLayoutCompat>
