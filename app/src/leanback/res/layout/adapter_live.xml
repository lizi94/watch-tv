<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- 行高刻意写 40dp 字面值，不要套 ag_dialog_item_h(64dp)：那是弹窗列表的触控行高，
         套到直播源列表会让条目高 +60%，整个「选择直播源」弹窗的版式被撑变形。 -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:background="@drawable/selector_chip_round"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="@dimen/ag_text_body"
        tools:text="https://fongmi.github.io/live.json" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pass"
        app:tint="@color/ag_text"
        android:layout_width="@dimen/ag_icon_40"
        android:layout_height="@dimen/ag_icon_40"
        android:layout_marginStart="@dimen/ag_space_3"
        android:background="@drawable/selector_chip_round"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="@dimen/ag_space_2"
        android:src="@drawable/ic_live_pass" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/boot"
        app:tint="@color/ag_text"
        android:layout_width="@dimen/ag_icon_40"
        android:layout_height="@dimen/ag_icon_40"
        android:layout_marginStart="@dimen/ag_space_3"
        android:background="@drawable/selector_chip_round"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="@dimen/ag_space_2"
        android:src="@drawable/ic_live_boot" />

</androidx.appcompat.widget.LinearLayoutCompat>