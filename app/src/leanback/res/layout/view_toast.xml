<?xml version="1.0" encoding="utf-8"?>
<!-- 全局浮层提示（Toast）：电视版覆盖版 —— 用电视版 ag_* 设计令牌。
     字号用 ag_text_title（32sp，比正文大 1/3）：浮层是「一闪而过」的单次提示，
     老人必须一眼可读，正文号不够 —— 2026-10-16 定案（用户确认）。
     随「字号大小」档位与屏幕尺寸补偿等比放大。
     main 同名布局保留手机版原样，手机端不继承电视版的老人友好令牌。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_toast"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ag_space_6"
    android:paddingTop="@dimen/ag_space_3"
    android:paddingEnd="@dimen/ag_space_6"
    android:paddingBottom="@dimen/ag_space_3">

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/ag_text_title" />

</LinearLayout>