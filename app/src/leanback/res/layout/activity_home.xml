<?xml version="1.0" encoding="utf-8"?>
<!-- 首页：外框 FrameLayout 只承载页面主体。
     空态改为「内容流中的占位卡」：由 EmptyCardPresenter 在分类 chips 行之后渲染一张
     宽撑满、高固定（屏幕可视高度的一定比例、不延伸屏底）的空白卡片，
     空态文案在卡内水平+垂直居中，随内容流自然滚动（占位效果，不漂移）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ag_space_6"
            android:paddingTop="@dimen/ag_space_6"
            android:paddingEnd="@dimen/ag_space_6"
            android:paddingBottom="@dimen/ag_space_2">

            <!-- ⛔⛔ 2026-10-29（R100）：logo 恒为**软件自己的图标**（这里的 ic_logo），
                 代码里没有任何地方再写这个 ImageView（原 HomeActivity#setLogo() 已整块删除）。
                 它曾经会被「数据源配置里的 logo」覆盖 —— 换源后标题区图标跟着变，与
                 「标题区 = 软件 logo + 软件名 + 时间、与数据源无关」的口径冲突。
                 ⇒ 想换 logo 只能换 @drawable/ic_logo 资源，不要在代码里 setImageXXX。 -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/logo"
                android:layout_width="@dimen/ag_icon_48"
                android:layout_height="@dimen/ag_icon_48"
                android:layout_marginEnd="@dimen/ag_space_3"
                android:src="@drawable/ic_logo" />

            <!-- ⛔⛔ 2026-10-29（R99）：标题由 CustomTitleView（自定义类已整体删除）改为纯 MaterialTextView。
                 两条硬规则（别再改回去）：
                 ① 文字恒为 @string/app_name，**代码里不再 setText** ⇒ 不随站源 / 配置 / 网络状态变动；
                 ② 本控件与整条 toolbar **恒显示**，不得再按列表选中位置切换 visibility。
                 这样「没有数据源 / 没有网络」时标题与时间区域也一定在（原先就是被 toggle 隐藏掉的）。
                 ellipsize=marquee + singleLine 保留：换语言后软件名可能超宽，靠跑马灯兜底
                 （跑马灯开关是 setFocus 里的 setSelected(true)，与焦点无关）。 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:focusable="false"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/ag_text"
                android:textSize="@dimen/ag_text_title" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ag_text"
                android:textSize="@dimen/ag_text_title"
                tools:text="09:20:00" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 内容容器：承载「进度网格」。
             空态占位卡由 EmptyCardPresenter 作为内容流中的一行渲染，不再使用独立的浮层区域。

             ⚠ 空态占位卡绝不能放进 ProgressLayout 内部：ProgressLayout.addView 会把不带
             TAG_PROGRESS 的子视图登记成「内容视图」，被 showContent() 强制显示、被 showProgress()
             干扰（R23/R24 已踩过的坑）。 -->
        <FrameLayout
            android:id="@+id/contentArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.fongmi.android.tv.ui.custom.ProgressLayout
                android:id="@+id/progressLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.leanback.widget.VerticalGridView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/ag_space_6"
                    android:paddingTop="@dimen/ag_space_2"
                    android:paddingEnd="@dimen/ag_space_6"
                    android:paddingBottom="@dimen/ag_space_6"
                    app:focusOutEnd="true"
                    app:focusOutFront="true" />

            </com.fongmi.android.tv.ui.custom.ProgressLayout>

        <!-- 启动等待提示（「正在连接网络…」）。
             只在「配置加载失败、且当前确实没网」时由 HomeActivity#showBootHint() 显示，
             用来告诉老人软件还在努力、不是死机 —— 因为按新策略无网时不会再自动降级成空态，
             而是保持启动画面一直等到网络就绪（就绪即进入）。
             切到内容态（showContent）会自动隐藏。

             ⚠ 必须放在 ProgressLayout **之外**（作为 contentArea 的直接子视图）：
             ProgressLayout.addView 会把不带 TAG_PROGRESS 的子视图登记成「内容视图」，
             那样它会在 PROGRESS 态被一起隐藏 —— 等于永远看不见。
             位置：整屏居中 + 下推 64dp（转圈卡片高约 80dp，半高 40dp，留 24dp 间距），
             与 view_progress 的居中卡片不重叠。 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/bootHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/ag_space_16"
            android:gravity="center"
            android:text="@string/home_connect_hint"
            android:textColor="@color/ag_text_sub"
            android:textSize="@dimen/ag_text_body"
            android:visibility="gone"
            tools:visibility="visible" />

        </FrameLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
