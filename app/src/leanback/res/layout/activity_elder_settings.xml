<?xml version="1.0" encoding="utf-8"?>
<!-- 长辈设置页（电视版）：适老化相关设置的唯一入口。尺寸与配色走 ag_* 设计令牌，行样式走 Ag.* 组件样式。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="NestedWeights">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/ag_space_6">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Ag.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/elder_setting_title" />

        <!-- ============ 锁定 ============ -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_5"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/ag_space_1"
                android:layout_height="@dimen/ag_space_6"
                android:background="@drawable/shape_ag_bar" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ag_space_3"
                android:text="@string/elder_setting_group_lock"
                android:textColor="@color/ag_text"
                android:textSize="@dimen/ag_text_headline" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/lock"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_3"
            android:nextFocusDown="@id/full"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_lock_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/lockText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="未锁定" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- ============ 播放 ============ -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_5"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/ag_space_1"
                android:layout_height="@dimen/ag_space_6"
                android:background="@drawable/shape_ag_bar" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ag_space_3"
                android:text="@string/elder_setting_group_play"
                android:textColor="@color/ag_text"
                android:textSize="@dimen/ag_text_headline" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/full"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_3"
            android:nextFocusDown="@id/resume"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_full_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/fullText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="开启" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/resume"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/sound"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_resume_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/resumeText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="开启" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/sound"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/indexSearch"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_sound_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/soundText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="开启" />
        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/indexSearch"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/font"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_index_search_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/indexSearchText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="关闭" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- ============ 显示 ============ -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_5"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/ag_space_1"
                android:layout_height="@dimen/ag_space_6"
                android:background="@drawable/shape_ag_bar" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ag_space_3"
                android:text="@string/elder_setting_group_display"
                android:textColor="@color/ag_text"
                android:textSize="@dimen/ag_text_headline" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/font"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_3"
            android:nextFocusDown="@id/size"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_font_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/fontText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="标准" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/size"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/restore"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_size_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/sizeText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="中" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- ============ 数据 ============ -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_5"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/ag_space_1"
                android:layout_height="@dimen/ag_space_6"
                android:background="@drawable/shape_ag_bar" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ag_space_3"
                android:text="@string/elder_setting_group_data"
                android:textColor="@color/ag_text"
                android:textSize="@dimen/ag_text_headline" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/restore"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_3"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/elder_setting_restore_entry" />
        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
