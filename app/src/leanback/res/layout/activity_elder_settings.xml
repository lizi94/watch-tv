<?xml version="1.0" encoding="utf-8"?>
<!-- 长辈设置页（电视版）：适老化相关设置的唯一入口。尺寸与配色走 ag_* 设计令牌，行样式走 Ag.* 组件样式。

     2026-10-27：**去掉分类标题，按优先级单列排序**（用户定案）。
     顺序原则：锁定 → 站源 → 显示 → 播放 → 交互 → 恢复默认（越靠前越重要、越少动）。
     ⚠ TV 每行的 nextFocusDown 必须指向「新顺序里的下一行」，改顺序时这里要同步改，
       否则遥控器按「下」会按旧顺序乱跳。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="NestedWeights">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/ag_space_6">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Ag.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/elder_setting_title" />

        <!-- 1. 一键锁定 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/lock"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/siteManage"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_lock_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/lockText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="未锁定" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 2. 站源管理 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/siteManage"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_2"
            android:nextFocusDown="@id/font"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/site_manage_title" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/siteManageText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="20 / 80" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 3. 字体大小 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/font"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_2"
            android:nextFocusDown="@id/size"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_font_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/fontText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="标准" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 4. 图片尺寸 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/size"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_2"
            android:nextFocusDown="@id/full"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_size_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/sizeText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="中" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 5. 点播自动全屏 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/full"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_2"
            android:nextFocusDown="@id/resume"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_full_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/fullText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="开启" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 6. 退出自动续播 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/resume"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_2"
            android:nextFocusDown="@id/bootAutostart"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_resume_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/resumeText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="开启" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 6.5 开机自启动（适老化）：关闭后开机不再自动打开本软件，停在原桌面。
             门控在 BootReceiver#launchHome（读 Setting.isBootAutostart）。 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/bootAutostart"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_2"
            android:nextFocusDown="@id/homeGuard"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_boot_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/bootAutostartText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="开启" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 6.6 接管 Home 键（2026-10-29）：按主页键回到电视桌面时自动切回本软件。
             实现在 HomeGuardService（无障碍服务），门控读 Setting.isHomeGuard()。
             需要用户在系统无障碍设置里开启本服务才生效，仅靠此处开关不够。 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/homeGuard"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_2"
            android:nextFocusDown="@id/indexSearch"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_home_guard_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/homeGuardText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="开启" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 7. 首页快速搜索 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/indexSearch"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_2"
            android:nextFocusDown="@id/sound"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_index_search_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/indexSearchText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="关闭" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 8. 遥控器按键音 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/sound"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_2"
            android:nextFocusDown="@id/restore"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_sound_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/soundText"
                style="@style/Ag.Text.Value"
                android:layout_height="wrap_content"
                tools:text="开启" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 9. 恢复默认设置（破坏性操作，固定最后） -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/restore"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/elder_setting_restore_entry" />
        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
