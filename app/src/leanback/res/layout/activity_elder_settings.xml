<?xml version="1.0" encoding="utf-8"?>
<!-- 长辈设置页（电视版）：适老化相关设置的唯一入口。尺寸与配色走 ag_* 设计令牌，行样式走 Ag.* 组件样式。

     2026-10-27：**去掉分类标题，按优先级单列排序**（用户定案）。
     顺序原则：锁定 → 站源 → 显示 → 播放 → 交互 → 恢复默认（越靠前越重要、越少动）。
     ⚠ TV 每行的 nextFocusDown 必须指向「新顺序里的下一行」，改顺序时这里要同步改，
       否则遥控器按「下」会按旧顺序乱跳。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="NestedWeights">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/ag_space_6">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Ag.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/elder_setting_title" />

        <!-- 1. 一键锁定 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/lock"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/siteManage"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_lock_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/lockText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="未锁定" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 2. 站源管理 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/siteManage"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/font"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/site_manage_title" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/siteManageText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="20 / 80" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 3. 字体大小 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/font"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/size"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_font_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/fontText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="标准" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 4. 图片尺寸 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/size"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/full"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_size_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/sizeText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="中" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 5. 点播自动全屏 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/full"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/resume"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_full_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/fullText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="开启" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 6. 退出自动续播 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/resume"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/bootLive"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_resume_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/resumeText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="开启" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 6.5 直播开机直达 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/bootLive"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/selfCheck"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_boot_live_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/bootLiveText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="关闭" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 6.8 启动与桌面体检（R101）：四行状态 + 「一键检查并修复」，
             把「开机自启 / 后台不被清理 / 按主页键回到看电视 / 设为电视主页」四件事收在一页，
             子女帮老人装机时按顺序点一遍即可。 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/selfCheck"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/indexSearch"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_self_check_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/selfCheckText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="4 项" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 7. 首页快速搜索 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/indexSearch"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/blockThird"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_index_search_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/indexSearchText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="关闭" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- R138「屏蔽内容提示」：站源公告、解析/推送/弹幕字幕搜索提示不再弹出 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/blockThird"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/sound"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_block_third_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/blockThirdText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="开启" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 8. 遥控器按键音 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/sound"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:nextFocusDown="@id/restore"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ag_space_4"
                android:text="@string/elder_setting_sound_entry" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/soundText"
                style="@style/Ag.Text.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="开启" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 9. 恢复默认设置（破坏性操作，固定最后） -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/restore"
            style="@style/Ag.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ag_space_4"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Ag.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/elder_setting_restore_entry" />
        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
