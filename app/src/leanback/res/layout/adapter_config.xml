<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="@dimen/ag_dialog_item_h"
        android:layout_weight="1"
        android:background="@drawable/selector_chip_round"
        android:ellipsize="middle"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/ag_text"
        android:textSize="@dimen/ag_text_body"
        tools:text="https://fongmi.github.io/cat.json" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/delete"
        app:tint="@color/ag_text"
        android:layout_width="@dimen/ag_icon_40"
        android:layout_height="@dimen/ag_icon_40"
        android:layout_marginStart="@dimen/ag_space_3"
        android:background="@drawable/selector_chip_round"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="@dimen/ag_space_2"
        android:src="@drawable/ic_setting_delete" />

</androidx.appcompat.widget.LinearLayoutCompat>