<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗输入框的聚焦态：焦点进入输入框时描边转主色并加粗，
     老人一眼能看出「现在光标在哪」。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/ag_card" />

    <corners android:radius="@dimen/ag_radius_m" />

    <stroke
        android:width="@dimen/ag_stroke_focus"
        android:color="@color/ag_primary" />

    <padding
        android:bottom="@dimen/ag_space_2"
        android:left="@dimen/ag_space_3"
        android:right="@dimen/ag_space_3"
        android:top="@dimen/ag_space_2" />

</shape>
