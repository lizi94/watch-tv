<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/black_40" />

    <!-- 圆角 8dp 是上游原值，**不要**套 ag_radius_m(12dp) —— 令牌值不等价，套上去播放页
         （live/vod/cast 三处）的提示面板会明显变圆，与上游观感不一致。 -->
    <corners android:radius="8dp" />

    <padding
        android:bottom="@dimen/ag_space_4"
        android:left="@dimen/ag_space_4"
        android:right="@dimen/ag_space_4"
        android:top="@dimen/ag_space_4" />

</shape>
