<?xml version="1.0" encoding="utf-8"?>
<!-- 危险按钮 · 聚焦态：红实底 + 白字（4.9:1），一眼识别「这是不可逆操作」 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/ag_danger" />

    <corners android:radius="@dimen/ag_radius_l" />

    <stroke
        android:width="@dimen/ag_stroke_focus"
        android:color="@color/ag_danger_stroke" />

    <padding
        android:bottom="@dimen/ag_space_2"
        android:left="@dimen/ag_space_3"
        android:right="@dimen/ag_space_3"
        android:top="@dimen/ag_space_2" />

</shape>
