<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮 · 聚焦态：仍是主色实底，靠亮色焦点环区分，
     这样「聚焦」不会把按钮的层级感抹掉（原来一聚焦就变浅色，等于失去了主按钮的身份）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/ag_primary_bg" />

    <corners android:radius="@dimen/ag_radius_l" />

    <stroke
        android:width="@dimen/ag_stroke_focus"
        android:color="@color/ag_focus_ring" />

    <padding
        android:bottom="@dimen/ag_space_2"
        android:left="@dimen/ag_space_3"
        android:right="@dimen/ag_space_3"
        android:top="@dimen/ag_space_2" />

</shape>
