<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器控制条按钮 · 聚焦态：主色面 + 亮蓝描边，白字对主色 6.39:1 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/ag_primary" />

    <corners android:radius="@dimen/ag_radius_s" />

    <stroke
        android:width="@dimen/ag_stroke_focus"
        android:color="@color/ag_focus_on_dark" />

    <padding
        android:bottom="@dimen/ag_space_2"
        android:left="@dimen/ag_space_3"
        android:right="@dimen/ag_space_3"
        android:top="@dimen/ag_space_2" />

</shape>
