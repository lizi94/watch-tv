<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 直播浮层列表项的焦点框：圆角 4dp / 描边 1.5dp 是上游原值，**不要**套 ag_radius_s(8dp) /
         ag_stroke_focus(现 5dp) —— 那两个全局令牌的值比原值高，套上去焦点框会明显变粗变圆，
         与上游观感不一致（这不是「重构」，是改版式）。 -->
    <corners android:radius="4dp" />

    <stroke
        android:width="1.5dp"
        android:color="@color/white" />

    <padding
        android:bottom="@dimen/ag_space_3"
        android:left="@dimen/ag_space_3"
        android:right="@dimen/ag_space_3"
        android:top="@dimen/ag_space_3" />

</shape>
