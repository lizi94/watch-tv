<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮 · 正常态：主色实底。之前主按钮误用了浅色 selector_button，
     在白底上又配白色文字，等于完全看不见，这里独立成主色实底。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/ag_primary" />

    <corners android:radius="@dimen/ag_radius_l" />

    <stroke
        android:width="@dimen/ag_stroke_normal"
        android:color="@color/ag_primary" />

    <padding
        android:bottom="@dimen/ag_space_2"
        android:left="@dimen/ag_space_3"
        android:right="@dimen/ag_space_3"
        android:top="@dimen/ag_space_2" />

</shape>
