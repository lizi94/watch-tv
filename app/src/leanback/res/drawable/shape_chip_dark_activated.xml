<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器控制条按钮 · 选中态：深灰面 + 亮蓝描边，与聚焦态靠描边区分 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/ag_chip_dark_bg" />

    <corners android:radius="@dimen/ag_radius_s" />

    <stroke
        android:width="@dimen/ag_stroke_normal"
        android:color="@color/ag_focus_on_dark" />

    <padding
        android:bottom="@dimen/ag_space_2"
        android:left="@dimen/ag_space_3"
        android:right="@dimen/ag_space_3"
        android:top="@dimen/ag_space_2" />

</shape>
