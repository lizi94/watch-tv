<?xml version="1.0" encoding="utf-8"?>
<!-- 筛选值胶囊 · 两形态背景（首页筛选弹窗专享：每个可选值 + 右上角「重置」按钮共用这一份）。
     ⛔ R162：普通态由「浅灰底 ag_btn_bg + 发丝描边」改为**直接引用分类行的 shape_home_chip**
     （白底 ag_card + 主色 ag_stroke_normal 描边）。此前两份注释都写「与分类行同构」，实际
     底色、描边颜色、描边粗细三项全不同，弹窗里的胶囊和首页分类 chip 看着是两个体系。
     焦点 / 选中态仍是主色实底无描边（两边本来就一致），保持不变。
     ⛔ 改这里必须同步 selector_home_chip：只要一侧改了另一侧没改，就会再次分叉。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 焦点：主色实底（与选中同形，无描边） -->
    <item android:state_focused="true" android:drawable="@drawable/shape_home_chip_focus" />

    <!-- 选中：主色实底（与焦点同形，无描边） -->
    <item android:state_selected="true" android:drawable="@drawable/shape_home_chip_focus" />

    <!-- 普通：白底 + 主色描边（与分类行同一份 drawable，不再各写一套） -->
    <item android:drawable="@drawable/shape_home_chip" />
</selector>
