<?xml version="1.0" encoding="utf-8"?>
<!-- 筛选值胶囊 · 两形态背景（只给首页筛选弹窗用，不动全站 chip 的 selector，避免误伤）。
     R158 D4：由四形态收敛为两形态，与首页分类 chip（selector_home_chip）同构 —— 焦点与选中共用同一形态，
     改一处必须两边同步（selector_home_chip.xml）。收敛原因见 PLAN-R158 §3.2。
        · 焦点 或 选中 → 主色实底 + 白字（不再区分「停在哪」与「已生效」，蓝块语义退化为「这一项可操作」）
        · 普通        → 浅灰底 + 发丝描边 + 深色字
     圆角 100dp 胶囊、描边向内不占尺寸（聚焦前后高度不变）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 焦点：主色实底（与选中同形，无描边） -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ag_primary" />
            <corners android:radius="@dimen/ag_radius_full" />
        </shape>
    </item>

    <!-- 选中：主色实底（与焦点同形，无描边） -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ag_primary" />
            <corners android:radius="@dimen/ag_radius_full" />
        </shape>
    </item>

    <!-- 普通 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ag_btn_bg" />
            <corners android:radius="@dimen/ag_radius_full" />
            <stroke
                android:width="@dimen/ag_stroke_hairline"
                android:color="@color/ag_stroke" />
        </shape>
    </item>
</selector>
