<?xml version="1.0" encoding="utf-8"?>
<!-- 筛选值胶囊 · 四态背景（**只给首页筛选弹窗用**，不动全站 chip 的 selector，避免误伤）。
     选中 / 焦点 是两件事，必须能同时表达：
       · 选中（当前已生效的条件）→ 主色实底 + 白字
       · 焦点（遥控器当前停着）  → 浅底 + 6dp 主色描边 + 主色字
       · 选中 + 焦点             → 主色实底 + **白色** 6dp 描边（蓝框画在蓝底上看不见）
       · 普通                    → 浅灰底 + 发丝描边 + 深色字
     圆角 100dp 胶囊、描边向内不占尺寸（聚焦前后高度不变），符合全站焦点态规格。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 选中 + 焦点：主色实底 + 白色焦点环（主色环在实底上不可见） -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ag_primary" />
            <corners android:radius="@dimen/ag_radius_full" />
            <stroke
                android:width="@dimen/ag_stroke_focus"
                android:color="@color/white" />
        </shape>
    </item>

    <!-- 只是焦点：浅底 + 主色环（与全站焦点态完全一致） -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ag_primary_bg" />
            <corners android:radius="@dimen/ag_radius_full" />
            <stroke
                android:width="@dimen/ag_stroke_focus"
                android:color="@color/ag_focus_ring" />
        </shape>
    </item>

    <!-- 只是选中：主色实底 + 发丝描边（维持高度一致，视觉上不缩水） -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ag_primary" />
            <corners android:radius="@dimen/ag_radius_full" />
            <stroke
                android:width="@dimen/ag_stroke_hairline"
                android:color="@color/ag_primary" />
        </shape>
    </item>

    <!-- 普通 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ag_btn_bg" />
            <corners android:radius="@dimen/ag_radius_full" />
            <stroke
                android:width="@dimen/ag_stroke_hairline"
                android:color="@color/ag_stroke" />
        </shape>
    </item>
</selector>
