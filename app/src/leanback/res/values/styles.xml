<resources>

    <!-- 电视版老人友好浅色主题：所有界面统一使用，播放/直播画面浮层保持深色（功能性要求，非风格混搭） -->
    <style name="Theme.Base" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ag_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/ag_primary_bg</item>
        <item name="colorOnPrimaryContainer">@color/ag_primary_text</item>
        <item name="colorSecondary">@color/ag_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/ag_card</item>
        <item name="colorOnSurface">@color/ag_text</item>
        <item name="colorSurfaceVariant">@color/ag_btn_bg</item>
        <item name="colorOnSurfaceVariant">@color/ag_text_sub</item>
        <item name="android:colorBackground">@color/ag_bg</item>
        <item name="colorOnBackground">@color/ag_text</item>
        <item name="colorOutline">@color/ag_stroke</item>
        <item name="colorOutlineVariant">@color/ag_stroke</item>
        <item name="colorError">@color/ag_warn_text</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorAccent">@color/ag_primary</item>
        <item name="android:windowBackground">@color/ag_bg</item>
        <item name="android:textColorPrimary">@color/ag_text</item>
        <item name="android:textColorSecondary">@color/ag_text_sub</item>
        <item name="android:textColorHint">@color/ag_text_hint</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowBackground">@color/ag_bg</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="NoAnim">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Shadow">
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:shadowDx">1.5</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <!-- 播放器控制条按钮（位于视频画面上，使用浅色文字 + 大字号） -->
    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- 深色控制条专用芯片：普通深灰面/聚焦主色面，白字全程高对比 -->
        <item name="android:background">@drawable/selector_chip_dark</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:nextFocusUp">@id/exo_progress</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:textSize">@dimen/ag_text_caption</item>
    </style>

    <!-- ================================================================
         长辈友好组件样式（统一按钮 / 卡片 / 列表项 / 分组标题 / 筛选标签 / 分割线）
         目的：消除 41 个 drawable 碎片化与逐处硬编码，改一处即全站生效。
         ================================================================ -->

    <!-- 长辈组件样式树的根节点。
         AAPT2 会按「去掉最后一段」推导隐式父样式：Ag.ListItem / Ag.Divider 会去找
         Ag，Ag.Button.Primary 会去找 Ag.Button，Ag.Keypad.Key 会去找 Ag.Keypad。
         这些中间节点若不存在，资源链接会直接失败（error: resource style/Ag not found）。
         因此整棵样式树必须显式成立，不能只写叶子节点。 -->
    <style name="Ag" />

    <!-- 分组标题：左侧主色竖条 + 大字 -->
    <style name="Ag.SectionHeader" parent="Ag.Text.Headline">
        <item name="android:drawablePadding">@dimen/ag_space_3</item>
        <item name="android:paddingStart">@dimen/ag_space_3</item>
    </style>

    <!-- 详情页 chips 区的小节标题（线路 / 清晰度 / 选集 / 排序）：次文字色 + 加粗，随行显隐。
         字号对齐首页行头（adapter_header.xml 的 ag_text_title = 32sp）的下沿：取 headline 28sp，
         保留 bold 与次文字色 —— 它是「小节标签」语义，与首页行头的「内容标题」不同，
         所以不做 32sp / 主文字色 的完全复制，只补足此前 22sp 与首页差 2 档的层级断裂。
         ⚠ 全项目仅 activity_video.xml 引用本样式（3 处），改动不波及其它页面。 -->
    <style name="Ag.GroupTitle" parent="Ag.Text.Headline">
        <item name="android:textColor">@color/ag_text_sub</item>
        <item name="android:paddingStart">@dimen/ag_space_6</item>
        <item name="android:paddingEnd">@dimen/ag_space_6</item>
        <item name="android:layout_marginBottom">@dimen/ag_space_1</item>
    </style>

    <!-- 通用可聚焦列表项 / 卡片 -->
    <style name="Ag.ListItem" parent="Ag">
        <item name="android:minHeight">@dimen/ag_touch_min</item>
        <item name="android:background">@drawable/selector_item</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:paddingStart">@dimen/ag_space_4</item>
        <item name="android:paddingEnd">@dimen/ag_space_4</item>
        <item name="android:paddingTop">@dimen/ag_space_3</item>
        <item name="android:paddingBottom">@dimen/ag_space_3</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- 圆角列表项（面板 / 弹窗内使用） -->
    <style name="Ag.ListItem.Round">
        <item name="android:background">@drawable/selector_item_round</item>
    </style>

    <!-- 图标按钮（设置页行尾小图标）：48dp 最小触控 + 图标居中，与列表行视觉协调 -->
    <style name="Ag.IconButton" parent="Ag">
        <item name="android:minWidth">@dimen/ag_touch_min</item>
        <item name="android:minHeight">@dimen/ag_touch_min</item>
        <item name="android:background">@drawable/selector_item</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:padding">@dimen/ag_space_3</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 按钮基类：所有按钮共有的「可聚焦 + 居中 + 最小宽度」，避免逐处重复 -->
    <style name="Ag.Button" parent="Ag">
        <item name="android:minWidth">@dimen/ag_space_16</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <!-- 主按钮（主色实底 + 白色大字）。
         必须用 selector_button_primary —— 若沿用浅色 selector_button，
         白底配白字会彻底看不见（这正是「按钮像不存在」的根因之一）。 -->
    <style name="Ag.Button.Primary" parent="Ag.Button">
        <item name="android:layout_height">@dimen/ag_button_h</item>
        <item name="android:background">@drawable/selector_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/ag_text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/ag_space_6</item>
        <item name="android:paddingEnd">@dimen/ag_space_6</item>
    </style>

    <!-- 次要按钮（浅底深字，用于并列的次级操作） -->
    <style name="Ag.Button.Secondary" parent="Ag.Button">
        <item name="android:layout_height">@dimen/ag_button_h</item>
        <item name="android:background">@drawable/selector_button</item>
        <item name="android:textColor">@color/ag_text</item>
        <item name="android:textSize">@dimen/ag_text_body</item>
        <item name="android:paddingStart">@dimen/ag_space_6</item>
        <item name="android:paddingEnd">@dimen/ag_space_6</item>
    </style>

    <!-- 危险按钮（删除/清空等不可逆操作）：淡红面红字，聚焦红实底白字 -->
    <style name="Ag.Button.Danger" parent="Ag.Button">
        <item name="android:layout_height">@dimen/ag_button_h</item>
        <item name="android:background">@drawable/selector_button_danger</item>
        <item name="android:textColor">@color/danger_button_text</item>
        <item name="android:textSize">@dimen/ag_text_body</item>
        <item name="android:paddingStart">@dimen/ag_space_6</item>
        <item name="android:paddingEnd">@dimen/ag_space_6</item>
    </style>

    <!-- 分组卡片内的「当前取值」：靠右、单行省略、主色加粗 -->
    <style name="Ag.Text.Value" parent="Ag.Text.Primary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">middle</item>
    </style>

    <!-- 分割线（统一 1dp + ag_divider） -->
    <style name="Ag.Divider" parent="Ag">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ag_stroke_hairline</item>
        <item name="android:background">@color/ag_divider</item>
    </style>

    <!-- 数字小键盘按键（解锁口令 / 电视遥控器输入用）。
         文字必须单行不省略：原方案没写 singleLine，2 个汉字的「确定」在 4 列
         布局里宽度不够，被折行/截断，看起来就像按钮不见了。 -->
    <!-- 键盘样式树的中间节点。AAPT2 推导隐式父样式时会来找 Ag.Keypad，
         此处显式声明，保证 Ag.Keypad.Key / .Back / .Confirm 三级链条完整。 -->
    <style name="Ag.Keypad" parent="Ag" />

    <style name="Ag.Keypad.Key" parent="Ag.Keypad">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/ag_button_h</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/selector_button</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">none</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/ag_text</item>
        <item name="android:textSize">@dimen/ag_text_headline</item>
    </style>

    <!-- 键盘功能键 · 退格（中性面，与数字键同族但文字用次级色） -->
    <style name="Ag.Keypad.Key.Back" parent="Ag.Keypad.Key">
        <item name="android:textColor">@color/ag_text_sub</item>
        <item name="android:textSize">@dimen/ag_text_label</item>
    </style>

    <!-- 键盘功能键 · 确定（主色实底 + 白字）。
         原方案退格与确定共用同一个浅色样式，在白色弹窗上完全看不出边界，
         这里把确定做成主色实底 —— 老人一眼就能找到「怎么确认」。 -->
    <style name="Ag.Keypad.Key.Confirm" parent="Ag.Keypad.Key">
        <item name="android:background">@drawable/selector_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/ag_text_label</item>
    </style>

</resources>
