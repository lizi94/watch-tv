# 统一行尾，避免 Windows / Linux 协作时整文件 diff
* text=auto eol=lf

# 可执行脚本保持 LF
gradlew text eol=lf
*.sh    text eol=lf

# Windows 批处理必须 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制：禁止行尾转换与文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.jar   binary
*.aar   binary
*.so    binary
*.pem   binary
*.jks   binary
*.keystore binary
*.apk   binary
*.zip   binary
*.ttf   binary
*.otf   binary
*.mp4   binary

# 语言统计
*.java  linguist-language=Java
*.gradle linguist-language=Groovy
